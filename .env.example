# SQLite inicia automaticamente quando DATABASE_URL estiver vazio.
DATABASE_URL=
# PostgreSQL: postgresql+psycopg://helpflow:SENHA@localhost:5432/helpflow
SECRET_KEY=
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:5000
HOST=127.0.0.1
PORT=5000
AUTO_MIGRATE=true
SEED_DEMO=false
# Obrigatória se SEED_DEMO=true. Nunca ative a demonstração em produção.
DEMO_PASSWORD=
MAIL_MODE=outbox
TIMEZONE=America/Sao_Paulo
RUN_JOBS_INLINE=true
# Caminho absoluto opcional para arquivos privados (útil ao restaurar backup)
UPLOAD_FOLDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=HelpFlow <no-reply@example.com>
SMTP_TLS=true
RATELIMIT_STORAGE_URI=memory://
